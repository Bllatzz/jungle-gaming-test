PORT=3000
# app: role de runtime, sem ownership das tabelas (criado por docker/postgres/init-roles.sql)
DATABASE_URL=postgres://wagering_app:wagering_app@localhost:5434/wagering
# migrations (e helpers de teste que precisam de DDL): dono das tabelas
MIGRATION_DATABASE_URL=postgres://wagering:wagering@localhost:5434/wagering
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo
# false: sobe só a API (sem consumer SQS, publisher da outbox e worker de referências)
WORKERS_ENABLED=true
# Quanto tempo o consumer insiste numa mensagem com erro transitório (banco fora) antes da DLQ. Padrão: 1800 (30 min).
# SQS_TRANSIENT_RETRY_TTL_SECONDS=1800
# Auth com o Keycloak (docker compose --profile auth up -d keycloak). As duas juntas ou nenhuma: vazias = auth desligada.
# AUTH_ISSUER=http://localhost:8180/realms/wagering
# AUTH_JWKS_URL=http://localhost:8180/realms/wagering/protocol/openid-connect/certs
# Traces OpenTelemetry (docker compose --profile observability up -d jaeger). Vazia = tracing desligado.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
